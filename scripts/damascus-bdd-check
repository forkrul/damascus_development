#!/usr/bin/env python3
"""damascus-bdd-check — Verify every Gherkin .feature file & Scenario is bound to executable step definitions.

Prevents the silent false-Green bug observed in two consumer repositories, where a
`.feature` file exists under `tests/bdd/features/`
but no `test_*.py` / step runner binds `scenarios("...")` or `@scenario(...)`,
causing `pytest` to exit 0 while executing 0 scenarios from that feature file.
"""
from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

SCENARIO_RE = re.compile(r"^\s*Scenario(?: Outline| Template)?\s*:\s*(.+)$", re.MULTILINE)


def count_scenarios_in_feature(feature_path: Path) -> int:
    text = feature_path.read_text(encoding="utf-8")
    return len(SCENARIO_RE.findall(text))


def find_feature_files(root: Path, feature_dirs: list[str]) -> list[Path]:
    dirs = [root / d for d in feature_dirs] if feature_dirs else [root / "tests", root / "features", root / "e2e"]
    features: list[Path] = []
    for d in dirs:
        if d.is_file() and d.suffix == ".feature":
            features.append(d)
        elif d.is_dir():
            features.extend(sorted(d.rglob("*.feature")))
    return sorted(set(features))


def find_step_runner_files(root: Path) -> list[Path]:
    search_dirs = [root / "tests", root / "test", root / "features", root / "e2e"]
    runners: list[Path] = []
    for d in search_dirs:
        if d.is_dir():
            for ext in ("*.py", "*.ts", "*.js", "*.rs", "*.go"):
                runners.extend(d.rglob(ext))
    return sorted(set(runners))


def is_feature_bound(feature_path: Path, runner_contents: dict[Path, str]) -> bool:
    fname = feature_path.name
    stem = feature_path.stem
    parent_and_name = f"{feature_path.parent.name}/{fname}"
    for content in runner_contents.values():
        if fname in content or parent_and_name in content:
            return True
        # Also allow directory-level `scenarios("features")` when scenarios() is called on parent dir
        if f'scenarios("{feature_path.parent.name}")' in content or f"scenarios('{feature_path.parent.name}')" in content:
            return True
        if f"scenarios('../{feature_path.parent.name}')" in content or f'scenarios("../{feature_path.parent.name}")' in content:
            return True
        if re.search(rf"\b{re.escape(stem)}\b", content) and ("@scenario" in content or "scenarios(" in content):
            return True
    return False


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="damascus-bdd-check",
        description="Verify that every .feature file contains >=1 Scenario and is bound in a test/step runner file.",
    )
    parser.add_argument(
        "--feature-dir",
        action="append",
        default=[],
        help="Feature directory or .feature file to check (default: auto-discover under tests/, features/, e2e/).",
    )
    parser.add_argument("--repo", type=Path, default=Path.cwd(), help="Target repository root.")
    args = parser.parse_args(argv)

    root = args.repo.resolve()
    features = find_feature_files(root, args.feature_dir)
    if not features:
        print("FAIL: No .feature files found.", file=sys.stderr)
        return 1

    runners = find_step_runner_files(root)
    runner_contents = {r: r.read_text(encoding="utf-8", errors="ignore") for r in runners}

    errors: list[str] = []
    total_scenarios = 0
    for f in features:
        rel = f.relative_to(root)
        sc_count = count_scenarios_in_feature(f)
        total_scenarios += sc_count
        if sc_count == 0:
            errors.append(f"[EMPTY]   {rel}: contains 0 Scenario blocks")
            continue
        if not is_feature_bound(f, runner_contents):
            errors.append(
                f"[UNBOUND] {rel} ({sc_count} scenario(s)): not referenced by any step/test runner file (`scenarios(...)` / `@scenario`)"
            )
        else:
            print(f"[BOUND]   {rel} ({sc_count} scenario(s))")

    if errors:
        for e in errors:
            print(e, file=sys.stderr)
        print(
            f"\nFAIL: {len(errors)}/{len(features)} .feature file(s) are empty or unbound (would pass pytest silently).",
            file=sys.stderr,
        )
        return 1

    print(f"\nOK: {len(features)} .feature file(s) ({total_scenarios} total scenarios) verified bound.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
