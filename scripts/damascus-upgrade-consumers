#!/usr/bin/env python3
"""damascus-upgrade-consumers — Inspect and upgrade downstream Damascus consumer repositories.

Supports:
  - Scanning a directory of repositories (--scan-dir) or inspecting explicit ones (--repo)
  - Gracefully detecting read-only bind mounts vs. writable consumer checkouts
  - Running each consumer's own `vendor/damascus/install.sh --all-harnesses` and `--verify`,
    so its links keep pointing at its pinned submodule. A repo without `vendor/damascus` is
    skipped unless `--link-to-this-checkout` is given, which links it to the checkout running
    this command instead (links that leave the repo, so a fresh clone of it won't have them).
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any

DAMASCUS_ROOT = Path(__file__).resolve().parent.parent
INSTALL_SH = DAMASCUS_ROOT / "install.sh"


def is_writable_dir(path: Path) -> bool:
    if not path.is_dir():
        return False
    return os.access(path, os.W_OK)


def inspect_consumer(repo: Path) -> dict[str, Any]:
    writable = is_writable_dir(repo)
    has_claude = (repo / ".claude" / "skills").is_dir()
    has_agents = (repo / ".agents" / "skills").is_dir()
    has_gemini = (repo / ".gemini" / "skills").is_dir()
    has_hone = (repo / ".claude" / "skills" / "hone").is_symlink() or (repo / ".claude" / "skills" / "hone").exists()
    vendor_damascus = repo / "vendor" / "damascus"
    submodule_sha = None
    if (vendor_damascus / ".git").exists():
        proc = subprocess.run(
            ["git", "-C", str(vendor_damascus), "rev-parse", "--short", "HEAD"],
            text=True,
            capture_output=True,
        )
        if proc.returncode == 0:
            submodule_sha = proc.stdout.strip()

    return {
        "path": str(repo),
        "name": repo.name,
        "exists": repo.is_dir(),
        "writable": writable,
        "harnesses": {
            ".claude": has_claude,
            ".agents": has_agents,
            ".gemini": has_gemini,
        },
        "has_v02_hone_skill": has_hone,
        "vendor_damascus_sha": submodule_sha,
    }


def consumer_installer(repo: Path, link_to_this_checkout: bool) -> Path | None:
    """The install.sh to run for a consumer: its own pinned vendor/damascus, else (only when
    asked) this checkout's. install.sh links into the checkout it lives in."""
    own = repo / "vendor" / "damascus" / "install.sh"
    if own.is_file():
        return own
    return INSTALL_SH if link_to_this_checkout else None


def upgrade_consumer(
    repo: Path, all_harnesses: bool = True, dry_run: bool = False, link_to_this_checkout: bool = False
) -> dict[str, Any]:
    info = inspect_consumer(repo)
    if not info["exists"]:
        info["status"] = "SKIPPED_MISSING"
        return info
    if not info["writable"] and not dry_run:
        info["status"] = "SKIPPED_READONLY_MOUNT"
        return info
    installer = consumer_installer(repo, link_to_this_checkout)
    if installer is None:
        info["status"] = "SKIPPED_NO_VENDOR"
        return info
    info["installer"] = str(installer)

    cmd = ["bash", str(installer)]
    if all_harnesses:
        cmd.append("--all-harnesses")
    if dry_run:
        cmd.append("--dry-run")

    proc = subprocess.run(cmd, cwd=str(repo), text=True, capture_output=True)
    info["install_returncode"] = proc.returncode
    if proc.returncode != 0:
        info["status"] = "FAILED"
        info["stderr"] = proc.stderr.strip()
        return info

    if not dry_run:
        ver = subprocess.run(["bash", str(installer), "--verify"], cwd=str(repo), text=True, capture_output=True)
        info["verify_returncode"] = ver.returncode
        info["status"] = "UPGRADED" if ver.returncode == 0 else "VERIFY_FAILED"
        info["harnesses"] = {
            ".claude": (repo / ".claude" / "skills").is_dir(),
            ".agents": (repo / ".agents" / "skills").is_dir(),
            ".gemini": (repo / ".gemini" / "skills").is_dir(),
        }
        info["has_v02_hone_skill"] = (repo / ".claude" / "skills" / "hone").is_symlink()
    else:
        info["status"] = "DRY_RUN_OK"

    return info


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="damascus upgrade-consumers",
        description="Inspect and re-link downstream Damascus consumer repositories, each with its own vendor/damascus installer.",
    )
    parser.add_argument(
        "--repo",
        action="append",
        default=[],
        help="Explicit consumer repository path to inspect/upgrade (repeatable).",
    )
    parser.add_argument(
        "--scan-dir",
        help="Directory whose immediate subdirectories should be scanned for Damascus consumer repos.",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Only inspect and report status without modifying consumer repositories.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Run install.sh --dry-run on target repositories.",
    )
    parser.add_argument(
        "--claude-only",
        action="store_true",
        help="Link only .claude/ instead of --all-harnesses (.claude, .agents, .gemini).",
    )
    parser.add_argument(
        "--link-to-this-checkout",
        action="store_true",
        help="For a repo without vendor/damascus, link it to this checkout instead of skipping it.",
    )
    parser.add_argument("--json", action="store_true", help="Emit JSON output.")
    args = parser.parse_args(argv)

    targets: list[Path] = []
    for r in args.repo:
        targets.append(Path(r).resolve())
    if args.scan_dir:
        scan_root = Path(args.scan_dir).resolve()
        if scan_root.is_dir():
            for child in sorted(scan_root.iterdir()):
                if child.is_dir() and ((child / ".git").exists() or (child / ".claude").exists()):
                    targets.append(child)
    if not targets:
        parser.error("give --scan-dir DIR or --repo PATH")

    results: list[dict[str, Any]] = []
    for repo in targets:
        if args.check:
            info = inspect_consumer(repo)
            info["status"] = "WRITABLE" if info["writable"] else "READONLY_MOUNT"
            results.append(info)
        else:
            results.append(
                upgrade_consumer(
                    repo,
                    all_harnesses=not args.claude_only,
                    dry_run=args.dry_run,
                    link_to_this_checkout=args.link_to_this_checkout,
                )
            )

    if args.json:
        print(json.dumps({"damascus_root": str(DAMASCUS_ROOT), "consumers": results}, indent=2))
    else:
        print(f"=== Damascus Consumer Repository Matrix ({len(results)} repos) ===")
        for r in results:
            harnesses = ",".join(k for k, v in r["harnesses"].items() if v) or "none"
            hone_str = "hone=yes" if r["has_v02_hone_skill"] else "hone=no"
            print(f"  [{r['status']:22s}] {r['name']:24s} harnesses={harnesses:22s} {hone_str}")
        if any(r["status"] == "SKIPPED_NO_VENDOR" for r in results):
            print("  SKIPPED_NO_VENDOR: no vendor/damascus/install.sh; pass --link-to-this-checkout to link to this checkout")

    return 1 if any(r["status"] in ("FAILED", "VERIFY_FAILED") for r in results) else 0


if __name__ == "__main__":
    raise SystemExit(main())
